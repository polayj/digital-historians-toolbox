// Cloudflare settings for the site. Wrangler (Cloudflare's command-line tool) reads this file.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "digital-historians-toolbox",
	"compatibility_date": "2026-10-14",
	"compatibility_flags": ["nodejs_als"],
	"pages_build_output_dir": ".svelte-kit/cloudflare",

	// Settings the code can read. SHOW_UNREVIEWED = "true" shows records still marked
	// needs_review, with a "Preview: not yet reviewed" banner. The live site will set it to "false".
	//
	// TURNSTILE_SITE_KEY is public (it goes into the page). The value here is Cloudflare's published
	// test key, which always passes; the real one is set when Turnstile is switched on (docs/SETUP.md).
	// Its partner, TURNSTILE_SECRET_KEY, is a secret: never put it in this file.
	//
	// ACCESS_TEAM_DOMAIN and ACCESS_AUD identify the Cloudflare Access application that protects
	// /admin. Left empty, /admin refuses everyone (except `npm run dev` on your own computer).
	"vars": {
		"SHOW_UNREVIEWED": "true",
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": "",
		// ORCID sign-in for "I'm using this now". ORCID_CLIENT_ID is public; its partner
		// ORCID_CLIENT_SECRET is a secret (docs/SETUP.md). Use https://sandbox.orcid.org to test.
		"ORCID_BASE": "https://orcid.org",
		"ORCID_CLIENT_ID": ""
	},

	// The D1 database. "DB" is the name the code uses to reach it.
	// database_id is a placeholder until the real database is created with
	// `npx wrangler d1 create toolbox`; local development works without it.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "toolbox",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	]
}
