# Copy this file to .dev.vars for local development. .dev.vars is never committed.
#
# Cloudflare's published Turnstile TEST keys: they always pass, and only work together. They replace
# the real site key from wrangler.jsonc on your own computer.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#
# Stands in for the Cloudflare Access sign-in when running `npm run dev` on your own computer.
# Ignored everywhere else.
DEV_ADMIN_EMAIL=editor@localhost.test
#
# "Sign in with ORCID" on your own computer: signs you in as ORCID's fictional test researcher,
# Josiah Carberry, without contacting ORCID. Ignored everywhere else.
DEV_ORCID_ID=0000-0002-1825-0097
DEV_ORCID_NAME=Josiah Carberry
#
# Real ORCID sign-in needs a secret from ORCID's developer tools (see docs/SETUP.md). Leave unset locally.
ORCID_CLIENT_SECRET=
